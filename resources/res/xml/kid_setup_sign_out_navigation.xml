<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@+id/kidsetup_destination_account_removal">
    <fragment
        android:name="com.google.android.gms.kids.setup.sentinel.CancelFragment"
        android:id="@+id/kidsetup_destination_cancel"/>
    <fragment
        android:name="com.google.android.gms.kids.setup.sentinel.DoneFragment"
        android:id="@+id/kidsetup_destination_done"/>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.AccountRemovalFragment"
        android:id="@+id/kidsetup_destination_account_removal">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_parent_picker"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/kidsetup_action_local_unlock"
            app:destination="@+id/kidsetup_destination_local_unlock"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.ParentPickerFragment"
        android:id="@+id/kidsetup_destination_parent_picker">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_parent_password"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.ParentPasswordFragment"
        android:id="@+id/kidsetup_destination_parent_password">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_account_removed_confirmation"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.LocalUnlockFragment"
        android:id="@+id/kidsetup_destination_local_unlock">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_account_removed_confirmation"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.AccountRemovedConfirmationFragment"
        android:id="@+id/kidsetup_destination_account_removed_confirmation">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_done"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
</navigation>

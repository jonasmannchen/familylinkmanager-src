<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@+id/kidsetup_destination_pre_check_pre_add_auth_hook">
    <fragment
        android:name="com.google.android.gms.kids.setup.sentinel.CancelFragment"
        android:id="@+id/kidsetup_destination_cancel"/>
    <fragment
        android:name="com.google.android.gms.kids.setup.sentinel.DoneFragment"
        android:id="@+id/kidsetup_destination_done"/>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.AuthAddAccountPreCheckFragment"
        android:id="@+id/kidsetup_destination_pre_check_pre_add_auth_hook">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_parent_escalation_pre_add_auth_hook"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.ParentEscalationFragment"
        android:id="@+id/kidsetup_destination_parent_escalation_pre_add_auth_hook">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_parent_picker_pre_add_auth_hook"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.ParentPickerFragment"
        android:id="@+id/kidsetup_destination_parent_picker_pre_add_auth_hook">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_parent_password_pre_add_auth_hook"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.ParentPasswordFragment"
        android:id="@+id/kidsetup_destination_parent_password_pre_add_auth_hook">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_secondary_account_consent"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.SecondaryAccountConsentFragment"
        android:id="@+id/kidsetup_destination_secondary_account_consent">
        <action
            android:id="@+id/kidsetup_action_back_to_parent_picker"
            app:popUpTo="@+id/kidsetup_destination_parent_picker_pre_add_auth_hook"/>
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_save_partial_consent_for_secondary_account_sign_in"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.SavePartialConsentForSecondaryAccountSignInFragment"
        android:id="@+id/kidsetup_destination_save_partial_consent_for_secondary_account_sign_in">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_done"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
</navigation>

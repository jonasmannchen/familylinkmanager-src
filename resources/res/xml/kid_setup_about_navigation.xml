<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@+id/kid_setup_destination_about_supervision_exit">
    <fragment
        android:name="com.google.android.gms.kids.setup.sentinel.CancelFragment"
        android:id="@+id/kidsetup_destination_cancel"/>
    <fragment
        android:name="com.google.android.gms.kids.setup.sentinel.DoneFragment"
        android:id="@+id/kidsetup_destination_done"/>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.geller.ErrorFragment"
        android:id="@+id/kid_setup_destination_error"/>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.geller.AboutSupervisionExitFragment"
        android:id="@+id/kid_setup_destination_about_supervision_exit">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kid_setup_destination_stop_supervision_warning"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.geller.StopSupervisionWarningFragment"
        android:id="@+id/kid_setup_destination_stop_supervision_warning">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_done"/>
    </fragment>
</navigation>

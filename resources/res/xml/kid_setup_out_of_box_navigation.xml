<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@+id/kidsetup_destination_init_device_setup">
    <fragment
        android:name="com.google.android.gms.kids.setup.sentinel.CancelFragment"
        android:id="@+id/kidsetup_destination_cancel"/>
    <fragment
        android:name="com.google.android.gms.kids.setup.sentinel.DoneFragment"
        android:id="@+id/kidsetup_destination_done"/>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.InitializeDeviceSetupFragment"
        android:id="@+id/kidsetup_destination_init_device_setup">
        <action
            android:id="@+id/kidsetup_action_reject_sign_in"
            app:destination="@+id/kidsetup_destination_member_rejection"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_device_name"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.MemberRejectionFragment"
        android:id="@+id/kidsetup_destination_member_rejection">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_cancel"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.DeviceNameFragment"
        android:id="@+id/kidsetup_destination_device_name">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_app_selector"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.AppSelectorFragment"
        android:id="@+id/kidsetup_destination_app_selector">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_activate_profile_owner"/>
        <action
            android:id="@+id/kidsetup_action_show_app_detail"
            app:destination="@+id/kidsetup_destination_app_detail"/>
        <action
            android:id="@+id/kidsetup_action_perma_lock"
            app:destination="@+id/kidsetup_destination_permalock_disclaimer"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.AppDetailFragment"
        android:id="@+id/kidsetup_destination_app_detail">
        <action
            android:id="@+id/kidsetup_action_show_app_detail_read_more"
            app:destination="@+id/kidsetup_destination_app_detail_read_more"/>
        <action
            android:id="@+id/kidsetup_action_show_app_permisison"
            app:destination="@+id/kidsetup_destination_app_permisison"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.AppDetailReadMoreFragment"
        android:id="@+id/kidsetup_destination_app_detail_read_more"/>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.AppPermissionFragment"
        android:id="@+id/kidsetup_destination_app_permisison"/>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.PermalockDisclaimerFragment"
        android:id="@+id/kidsetup_destination_permalock_disclaimer">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_activate_profile_owner"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.ActivateProfileOwnerFragment"
        android:id="@+id/kidsetup_destination_activate_profile_owner">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_google_services"/>
    </fragment>
    <fragment
        android:name="com.google.android.gms.kids.setup.fragment.GoogleServicesFragment"
        android:id="@+id/kidsetup_destination_google_services">
        <action
            android:id="@+id/kidsetup_action_next"
            app:destination="@+id/kidsetup_destination_done"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
</navigation>

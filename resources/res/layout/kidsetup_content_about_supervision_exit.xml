<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/about_supervision_exit_user_content"
        android:paddingBottom="24dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
            android:id="@+id/about_supervision_exit_user_avatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/about_supervision_exit_user_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_regular"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/account_supervised_by"
        style="@style/KidSetup.Subheading"/>
    <TextView
        android:id="@+id/family_manager_email"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/KidSetup.Subheading"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/family_manager_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/what_parents_can_manage_heading"
        style="@style/AboutSupervisionSectionHeading"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/what_parents_can_manage_description"
        style="@style/AboutSupervisionSectionContent"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/about_supervision_account_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionIcon="@drawable/quantum_ic_settings_grey600_24"
        app:sectionHeader="@string/account_settings_section_heading"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/apps_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionIcon="@drawable/quantum_ic_shop_grey600_24"
        app:sectionHeader="@string/apps_section_heading"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/location_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionIcon="@drawable/quantum_ic_place_grey600_24"
        app:sectionHeader="@string/location_section_heading"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/screen_time_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionIcon="@drawable/quantum_ic_timer_grey600_24"
        app:sectionHeader="@string/screen_time_section_heading"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/google_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionIcon="@drawable/quantum_ic_search_grey600_24"
        app:sectionHeader="@string/google_section_heading"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/change_supervision_heading"
        style="@style/AboutSupervisionSectionHeading"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/change_supervision_description"
        style="@style/AboutSupervisionSectionContent"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/not_enough_screen_time_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionHeader="@string/not_enough_screen_time_heading"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/apps_are_blocked_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionHeader="@string/apps_are_blocked_heading"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/location_tracking_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionHeader="@string/location_tracking_heading"/>
    <TextView
        android:id="@+id/set_up_without_knowledge_heading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/set_up_without_knowledge_heading"
        style="@style/AboutSupervisionSectionHeading"/>
    <TextView
        android:id="@+id/set_up_without_knowledge_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/AboutSupervisionSectionContent"/>
    <TextView
        android:id="@+id/dont_want_supervision_heading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dont_want_supervision_heading"
        style="@style/AboutSupervisionSectionHeading"/>
    <TextView
        android:id="@+id/dont_want_supervision_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        style="@style/AboutSupervisionSectionContent"/>
</LinearLayout>

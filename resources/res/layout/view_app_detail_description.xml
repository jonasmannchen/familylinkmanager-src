<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:gravity="center"
        android:id="@+id/kidsetup_app_detail_description_promotion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.2"
        style="@style/quantum_text_subhead_black"/>
    <Button
        android:textColor="?android:attr/textColorLink"
        android:layout_gravity="center"
        android:id="@+id/kidsetup_app_detail_description_read_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/common_button_read_more"
        style="?android:attr/borderlessButtonStyle"/>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/kidsetup_app_detail_description_preview_image_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/kidsetup_app_detail_preview_images_content_description"/>
    </HorizontalScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/kidsetup_app_detail_description_rating_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <TextView
            android:textColor="@color/quantum_black_text"
            android:id="@+id/kidsetup_app_detail_description_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/quantum_text_display_1_black"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp">
            <RatingBar
                android:id="@+id/kidsetup_app_detail_description_rating_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:progressDrawable="@drawable/kidsetup_ic_rating_star"
                android:numStars="5"
                android:stepSize="0.1"
                android:isIndicator="true"
                style="?android:attr/ratingBarStyleSmall"/>
            <TextView
                android:id="@+id/kidsetup_app_detail_description_num_ratings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/quantum_text_caption_black"/>
        </LinearLayout>
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/quantum_ic_person_grey600_24"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.3"/>
    <ImageView
        android:id="@+id/kids_time_limit_header_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/kidsTimeLimitIcon"
        android:importantForAccessibility="no"/>
    <TextView
        android:gravity="center"
        android:id="@+id/kids_time_limit_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/kids_time_limit_title_adhoc"
        style="?attr/kidsTimeLimitHeadlineStyle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/kids_time_limit_header_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/kids_time_limit_desc_adhoc"
        style="?attr/kidsTimeLimitSubheadStyle"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"/>
    <Button
        android:id="@+id/kids_time_limit_whitelist_apps_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kids_time_limit_allowed_apps_btn"
        style="?attr/borderlessButtonStyle"/>
    <Button
        android:id="@+id/kids_time_limit_unlock_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kids_time_limit_unlock_btn"
        style="?attr/borderlessButtonStyle"/>
    <Button
        android:id="@+id/kids_time_limit_emergency_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kids_time_limit_emergency_btn"
        style="?attr/borderlessButtonStyle"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kid_setup_footer_glif"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/SuwGlifButtonBar">
    <Button
        android:id="@+id/kid_setup_secondary_action_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_skip"
        style="@style/SuwGlifButton.Secondary"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <Button
        android:id="@+id/kid_setup_primary_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/suw_next_button_label"
        style="@style/SuwGlifButton.Primary"/>
    <Button
        android:id="@+id/kid_setup_more_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/suw_more_button_label"
        style="@style/SuwGlifButton.Primary"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <Button
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:id="@+id/kidsetup_nav_bar_button_back"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/common_back"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="24dp"
        android:layout_alignParentStart="true"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
    <Button
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:id="@+id/kidsetup_nav_bar_button_next"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/common_next"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginEnd="24dp"
        android:layout_alignParentEnd="true"
        style="@style/Widget.AppCompat.Button.Colored"/>
    <Button
        android:textSize="14sp"
        android:id="@+id/kidsetup_nav_bar_button_right_colorless"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="24dp"
        android:layout_alignParentEnd="true"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
    <Button
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:id="@+id/kidsetup_nav_bar_button_more"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/common_more"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="24dp"
        android:layout_alignParentEnd="true"
        style="@style/Widget.AppCompat.Button.Colored"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
            android:id="@+id/other_devices_user_avatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/other_devices_user_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_regular"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/other_supervisable_devices_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="start"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/supervisable_devices_subtitle"/>
        <com.google.android.gms.kids.widget.TextViewWithActionLink
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="start"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/supervisable_devices_description"
            android:lineSpacingMultiplier="1.2"
            app:actionLinkUrl="@string/other_supervisable_devices_learn_more_url"
            app:actionLinkText="@string/common_learn_more"/>
        <LinearLayout
            android:gravity="start"
            android:orientation="vertical"
            android:id="@+id/other_supervisable_devices_list"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/unsupervisable_devices_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="start"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/unsupervisable_devices_subtitle"/>
        <com.google.android.gms.kids.widget.TextViewWithActionLink
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="start"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/unsupervisable_devices_description"
            android:lineSpacingMultiplier="1.2"
            app:actionLinkUrl="@string/unsupervisable_devices_learn_more_url"
            app:actionLinkText="@string/common_learn_more"/>
        <LinearLayout
            android:gravity="start"
            android:orientation="vertical"
            android:id="@+id/unsupervisable_devices_list"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>

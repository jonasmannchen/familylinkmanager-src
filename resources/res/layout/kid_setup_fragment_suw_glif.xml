<?xml version="1.0" encoding="utf-8"?>
<com.android.setupwizardlib.GlifLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kid_setup_fragment_suw_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.setupwizardlib.view.FillContentLayout
        android:id="@+id/kid_setup_circular_progress_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/SuwFourColorIndeterminateProgressBar"/>
    </com.android.setupwizardlib.view.FillContentLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/kid_setup_fragment_content_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/SuwContentFrame">
        <TextView
            android:id="@+id/kid_setup_subheading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/SuwDescription.Glif"/>
        <Space
            android:id="@+id/kid_setup_content_frame_space"
            android:layout_width="match_parent"
            android:layout_height="24dp"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/kid_setup_illustration"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="48dp"
            android:scaleType="center"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/kid_setup_description"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            style="@style/SuwDescription.Glif"/>
    </LinearLayout>
</com.android.setupwizardlib.GlifLayout>

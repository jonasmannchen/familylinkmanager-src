<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/background_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.gms.kids.setup.widget.KidSetupNavBar
        android:id="@+id/kidsetup_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:importantForAccessibility="no"
        app:useGlifLayout="true"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_above="@+id/kidsetup_nav_bar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/kid_setup_main_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="24dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/kidsetup_header_icon"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_margin="24dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"/>
            <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
                android:layout_gravity="center"
                android:id="@+id/kidsetup_network_header_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_margin="24dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/kidsetup_header_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp">
                        <TextView
                            android:id="@+id/kidsetup_headline"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/KidSetup.Headline"/>
                        <TextView
                            android:id="@+id/kidsetup_subheading"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/KidSetup.Subheading"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/kidsetup_illustration"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="48dp"
                        android:layout_marginBottom="24dp"
                        android:scaleType="center"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no"/>
                    <TextView
                        android:id="@+id/kidsetup_description"
                        android:focusable="true"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="24dp"
                        style="@style/KidSetup.Subheading"/>
                    <FrameLayout
                        android:id="@+id/kidsetup_content_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <com.google.android.gms.kids.setup.widget.InterstitialView
                    android:id="@+id/kidsetup_interstitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:useGlifLayout="true"/>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/allow_supervision_dialog_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/KidSetup.Headline"/>
        <TextView
            android:textSize="16sp"
            android:gravity="start"
            android:id="@+id/allow_supervision_dialog_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/allow_supervision_description"
            style="@style/TextAppearance.AppCompat.Body1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <Button
                android:textSize="14sp"
                android:id="@+id/dont_allow_supervision_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/dont_allow_supervision"
                android:fontFamily="sans-serif-medium"
                style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <Button
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:id="@+id/allow_supervision_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/common_allow"
                android:fontFamily="sans-serif-medium"
                style="@style/Widget.AppCompat.Button.Colored"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

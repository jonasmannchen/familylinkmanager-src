<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/member_sv_exit_complete_icon"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="48dp"
            android:src="@drawable/kidsetup_ic_google"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/quantum_black_text"
            android:id="@+id/member_sv_exit_complete_title"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/member_sv_exit_complete_title"
            style="@style/KidSetup.Headline"/>
        <ProgressBar
            android:id="@+id/member_sv_exit_complete_progress_bar"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="?attr/colorPrimary"
            android:indeterminateTintMode="src_in"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/quantum_black_text"
            android:id="@+id/member_sv_exit_complete_description"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:id="@+id/member_sv_exit_complete_close_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/close_button_label"
            android:fontFamily="sans-serif-medium"
            style="@style/Widget.AppCompat.Button.Colored"/>
    </LinearLayout>
</ScrollView>

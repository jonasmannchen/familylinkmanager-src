<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp"
    android:focusableInTouchMode="true"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
        android:id="@+id/kidsetup_failed_to_hide_item_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp">
        <TextView
            android:id="@+id/kidsetup_failed_to_hide_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.AppCompat.Subhead"/>
        <TextView
            android:id="@+id/kidsetup_failed_to_hide_item_developer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/quantum_ic_warning_googred_48"/>
</LinearLayout>

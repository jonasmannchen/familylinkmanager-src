<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.design.textfield.TextInputLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/pairing_code_input_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:errorEnabled="true"
        app:errorTextAppearance="@style/kidsetup_edit_text_error_style">
        <com.google.android.gms.kids.widget.SectionedCodeEditor
            android:textSize="24sp"
            android:id="@+id/pairing_code_editor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:maxLines="1"
            android:inputType="textVisiblePassword"
            android:imeOptions="flagNoFullscreen|actionDone"
            android:labelFor="@+id/pairing_code_input_layout"
            app:numSections="3"
            app:sectionLength="3"
            app:sectionCodeEditorColor="?android:attr/textColorSecondary"
            app:sectionCodeEditorColorFocused="?attr/colorPrimary"
            app:sectionCodeEditorColorError="@color/quantum_googred600"
            style="@style/TextAppearance.AppCompat.Body1"/>
    </android.support.design.textfield.TextInputLayout>
    <ProgressBar
        android:id="@+id/pairing_code_progress_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimary"
        android:indeterminateTintMode="src_in"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
            android:id="@+id/not_allowed_devices_user_avatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/not_allowed_devices_user_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_regular"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:background="@drawable/rounded_rectangle_outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/google_yellow900">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/quantum_ic_warning_black_24"
            android:scaleType="fitCenter"
            android:tint="@color/google_yellow900"
            android:importantForAccessibility="no"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/google_yellow900"
            android:gravity="start"
            android:id="@+id/not_allowed_devices_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_regular"/>
    </LinearLayout>
    <com.google.android.gms.kids.widget.TextViewWithActionLink
        android:textSize="16sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="start"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/not_allowed_devices_description"
        android:lineSpacingMultiplier="1.2"
        app:actionLinkUrl="@string/not_allowed_devices_learn_more_url"
        app:actionLinkText="@string/common_learn_more"/>
    <ListView
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/not_allowed_devices_list"
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@null"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.5">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kidsetup_app_detail_downloads_caption"
            android:maxLines="1"
            style="@style/quantum_text_body_1_black"/>
        <TextView
            android:textColor="@color/quantum_black_secondary_text"
            android:id="@+id/kidsetup_app_detail_info_downloads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/quantum_text_body_1_black"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/kidsetup_app_detail_offered_by_caption"
            android:maxLines="1"
            style="@style/quantum_text_body_1_black"/>
        <TextView
            android:textColor="@color/quantum_black_secondary_text"
            android:id="@+id/kidsetup_app_detail_info_offered_by"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/quantum_text_body_1_black"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.5">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kidsetup_app_detail_updated_on_caption"
            android:maxLines="1"
            style="@style/quantum_text_body_1_black"/>
        <TextView
            android:textColor="@color/quantum_black_secondary_text"
            android:id="@+id/kidsetup_app_detail_info_updated_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/quantum_text_body_1_black"/>
        <TextView
            android:id="@+id/kidsetup_app_detail_info_in_app_purchases_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/kidsetup_app_detail_in_app_purchases_cation"
            android:maxLines="1"
            style="@style/quantum_text_body_1_black"/>
        <TextView
            android:textColor="@color/quantum_black_secondary_text"
            android:id="@+id/kidsetup_app_detail_info_in_app_purchases"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/quantum_text_body_1_black"/>
    </LinearLayout>
</merge>

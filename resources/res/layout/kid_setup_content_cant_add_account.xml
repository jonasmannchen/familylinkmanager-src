<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp">
    <com.google.android.gms.kids.widget.TextViewWithActionLink
        android:id="@+id/cant_add_account_subheading"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cant_add_account_subheading"
        app:actionLinkUrl="@string/cant_add_account_learn_more_url"
        app:actionLinkText="@string/common_learn_more"
        style="@style/TextAppearance.AppCompat.Subhead"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/cant_add_account_how_to_add_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cant_add_account_how_to_add_header"
        style="@style/TextAppearance.AppCompat.Body1"/>
    <TextView
        android:id="@+id/cant_add_account_how_to_add_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.AppCompat.Body1"/>
    <com.google.android.gms.kids.setup.widget.NonScrollableListView
        android:id="@+id/cant_add_account_how_to_add_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:divider="@null"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/cant_add_account_why_is_this_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cant_add_account_why_is_this_header"
        style="@style/TextAppearance.AppCompat.Body1"/>
    <TextView
        android:id="@+id/cant_add_account_why_is_this_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cant_add_account_why_is_this_body"
        style="@style/TextAppearance.AppCompat.Body1"/>
</LinearLayout>

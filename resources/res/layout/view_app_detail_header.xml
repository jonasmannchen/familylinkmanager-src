<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/kidsetup_app_detail_header_app_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        android:layout_marginStart="24dp"/>
    <LinearLayout
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp">
        <TextView
            android:id="@+id/kidsetup_app_detail_header_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/quantum_text_title_black"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/quantum_black_secondary_text"
            android:id="@+id/kidsetup_app_detail_header_app_developer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/quantum_text_black_dark"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
                android:id="@+id/kidsetup_app_detail_header_app_category_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/kidsetup_app_detail_header_app_category_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/kidsetup_app_detail_header_switch_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="64dp">
        <Switch
            android:layout_gravity="center"
            android:id="@+id/kidsetup_app_detail_header_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</merge>

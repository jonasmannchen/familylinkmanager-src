<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/member_rejection_subtext"
        style="@style/KidSetup.Subheading"/>
    <TextView
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/member_rejection_action_title"
        style="@style/KidSetup.Subheading"/>
    <TextView
        android:id="@+id/kid_setup_member_rejection_action_subtext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        style="@style/KidSetup.Subheading"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/member_rejection_action_item1"
        style="@style/KidSetup.Subheading"/>
    <com.google.android.gms.kids.widget.TextViewWithActionLink
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/member_rejection_action_item2"
        app:actionLinkUrl="@string/cant_setup_supervision_learn_more_url"
        app:actionLinkText="@string/common_learn_more"
        style="@style/KidSetup.Subheading"/>
    <TextView
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/member_rejection_why_title"
        style="@style/KidSetup.Subheading"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/member_rejection_why_content"
        style="@style/KidSetup.Subheading"/>
</LinearLayout>

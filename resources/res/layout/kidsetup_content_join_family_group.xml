<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">
        <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
            android:id="@+id/join_family_supervisee_avatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/join_family_supervisee_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_regular"/>
    </LinearLayout>
    <TextView
        android:id="@+id/join_family_group_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/KidSetup.Subheading"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/family_manager_details"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp">
        <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
            android:id="@+id/family_manager_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:gravity="start"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/family_manager_name_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/family_manager_email_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.gms.kids.widget.TextViewWithActionLink
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:id="@+id/join_family_group_disclaimer"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/join_family_group_disclaimer"
        android:fontFamily="sans-serif"
        app:actionLinkUrl="@string/join_family_group_support_url"
        app:actionLinkText="@string/common_learn_more"/>
</LinearLayout>

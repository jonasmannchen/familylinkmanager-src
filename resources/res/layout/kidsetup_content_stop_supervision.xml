<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="24dp"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp">
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:background="@drawable/rounded_rectangle_outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/google_yellow900">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/quantum_ic_warning_black_24"
            android:scaleType="fitCenter"
            android:tint="@color/google_yellow900"
            android:importantForAccessibility="no"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/google_yellow900"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop_supervision_description_v2"
            android:fontFamily="@font/google_sans_regular"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/quantum_black_text"
        android:id="@+id/stop_supervision_devices_will_lock_until_18"
        android:paddingTop="32dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans_regular"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/devices_lock_until_18_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/quantum_black_text"
        android:id="@+id/stop_supervision_devices_will_lock_for_24_hrs"
        android:paddingTop="32dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans_regular"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/devices_lock_for_24_hrs_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/quantum_black_text"
        android:id="@+id/stop_supervision_devices_wont_lock"
        android:paddingTop="32dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans_regular"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/devices_wont_lock_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ProgressBar
        android:layout_gravity="center_horizontal"
        android:id="@+id/devices_list_progress_bar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        android:indeterminate="true"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/stop_supervision_checkbox_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:baselineAligned="false">
        <CheckBox
            android:id="@+id/stop_supervision_checkbox"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:colorButtonNormal="@color/quantum_grey500"
            android:colorAccent="@color/quantum_googblue"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/stop_supervision_checkbox_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stop_supervision_checkbox_label_v2_plural"
            android:labelFor="@+id/stop_supervision_checkbox"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/colorError"
        android:id="@+id/stop_supervision_checkbox_error"
        android:paddingTop="8dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stop_supervision_checkbox_error"/>
</LinearLayout>

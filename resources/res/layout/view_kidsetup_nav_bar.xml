<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@color/navbar_background_color"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <android.support.v7.widget.AppCompatButton
        android:gravity="start|center_vertical"
        android:id="@+id/kidsetup_nav_bar_button_back"
        android:contentDescription="@string/common_back"
        android:drawableStart="@drawable/navbar_ic_back"
        android:layout_alignParentStart="true"
        style="@style/kidsetup_navbar_button"/>
    <android.support.v7.widget.AppCompatButton
        android:gravity="end|center_vertical"
        android:id="@+id/kidsetup_nav_bar_button_more"
        android:visibility="gone"
        android:text="@string/common_more"
        android:drawableEnd="@drawable/navbar_ic_more"
        android:layout_alignParentEnd="true"
        style="@style/kidsetup_navbar_button"/>
    <android.support.v7.widget.AppCompatButton
        android:gravity="end|center_vertical"
        android:id="@+id/kidsetup_nav_bar_button_next"
        android:text="@string/common_next"
        android:drawableEnd="@drawable/navbar_ic_next"
        android:layout_alignParentEnd="true"
        style="@style/kidsetup_navbar_button"/>
    <android.support.v7.widget.AppCompatButton
        android:gravity="end|center_vertical"
        android:id="@+id/kidsetup_nav_bar_button_right_colorless"
        android:visibility="gone"
        android:layout_alignParentEnd="true"
        style="@style/kidsetup_navbar_button"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.design.textfield.TextInputLayout
        android:id="@+id/kidsetup_parent_password_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/parent_password_hint"
        android:importantForAccessibility="no"
        app:errorEnabled="true"
        app:errorTextAppearance="@style/kidsetup_edit_text_error_style"
        app:passwordToggleEnabled="true">
        <android.support.design.textfield.TextInputEditText
            android:id="@+id/kidsetup_parent_password_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:maxLines="1"
            android:inputType="textPassword"
            android:imeOptions="flagNoFullscreen|actionDone"
            android:contentDescription="@string/parent_password_hint"
            style="@style/TextAppearance.AppCompat.Body1"/>
    </android.support.design.textfield.TextInputLayout>
    <Button
        android:id="@+id/kidsetup_parent_forgot_password_button"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/parent_password_forgot"
        style="@style/kidsetup_url_button_style"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
        android:id="@+id/kidsetup_app_selector_row_app_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp">
        <TextView
            android:id="@+id/kidsetup_app_selector_row_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/quantum_text_subhead_black"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/kidsetup_app_selector_row_app_sub_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/kidsetup_app_selector_row_setting_gear"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:importantForAccessibility="no"
        android:layout_marginEnd="8dp"/>
    <FrameLayout
        android:id="@+id/kidsetup_app_selector_row_switch_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="64dp">
        <View
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            style="@style/kidsetup_vertical_divider"/>
        <Switch
            android:layout_gravity="center"
            android:id="@+id/kidsetup_app_selector_row_app_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>

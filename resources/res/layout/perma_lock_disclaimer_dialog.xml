<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <android.support.constraint.ConstraintLayout
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/kid_setup_perma_lock_dialog_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:text="@string/perma_lock_heading"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/KidSetup.Headline"/>
        <TextView
            android:textSize="16sp"
            android:id="@+id/kid_setup_perma_lock_dialog_description_1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/perma_lock_description_1"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@+id/kid_setup_perma_lock_dialog_heading"
            style="@style/TextAppearance.AppCompat.Body1"/>
        <com.google.android.gms.kids.widget.TextViewWithActionLink
            android:textSize="16sp"
            android:id="@+id/kid_setup_perma_lock_dialog_description_2"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/perma_lock_description_2"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@+id/kid_setup_perma_lock_dialog_description_1"
            app:actionLinkUrl="@string/stop_supervision_pixel_jp_learn_more_url"
            app:actionLinkText="@string/common_learn_more"
            style="@style/TextAppearance.AppCompat.Body1"/>
        <Button
            android:id="@+id/kid_setup_perma_lock_dialog_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/common_back"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/kid_setup_perma_lock_dialog_description_2"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
        <Button
            android:id="@+id/kid_setup_perma_lock_dialog_i_understand_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/perma_lock_i_understand"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/kid_setup_perma_lock_dialog_description_2"
            style="@style/Widget.AppCompat.Button.Colored"/>
    </android.support.constraint.ConstraintLayout>
</ScrollView>

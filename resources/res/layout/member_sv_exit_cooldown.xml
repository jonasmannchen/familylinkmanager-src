<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp">
    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/member_sv_exit_cooldown_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="@string/member_sv_exit_cooldown_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/KidSetup.Headline"/>
        <TextView
            android:id="@+id/member_sv_exit_cooldown_subheading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/member_sv_exit_cooldown_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/member_sv_exit_cooldown_heading"
            style="@style/KidSetup.Subheading"/>
        <ProgressBar
            android:id="@+id/member_sv_exit_cooldown_progress_bar"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progressDrawable="@drawable/member_sv_exit_cooldown_progress_bar"
            android:rotation="-90"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/member_sv_exit_cooldown_subheading"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/quantum_ic_lock_open_googblue_36"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/member_sv_exit_cooldown_time_remaining"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="36sp"
            android:textColor="@color/quantum_black_text"
            android:id="@+id/member_sv_exit_cooldown_time_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_regular"
            app:layout_constraintBottom_toBottomOf="@+id/member_sv_exit_cooldown_progress_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/member_sv_exit_cooldown_progress_bar"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/quantum_black_secondary_text"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/member_sv_exit_cooldown_device_will_lock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/member_sv_exit_cooldown_time_remaining"/>
        <Button
            android:textSize="14sp"
            android:gravity="start|center_vertical"
            android:id="@+id/member_sv_exit_cooldown_cancel_button"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:text="@string/common_cancel"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
    </android.support.constraint.ConstraintLayout>
</ScrollView>

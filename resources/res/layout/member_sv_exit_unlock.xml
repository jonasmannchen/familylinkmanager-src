<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="48dp"
            android:src="@drawable/kidsetup_ic_google"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
        <TextView
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/member_sv_exit_unlock_title"
            style="@style/KidSetup.Headline"/>
        <TextView
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/member_sv_exit_unlock_description"
            style="@style/KidSetup.Subheading"/>
        <android.support.constraint.ConstraintLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <android.support.design.textfield.TextInputLayout
                android:id="@+id/member_sv_exit_unlock_editor_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:errorEnabled="true"
                app:errorTextAppearance="@style/kidsetup_edit_text_error_style">
                <android.support.design.textfield.TextInputEditText
                    android:id="@+id/member_sv_exit_unlock_pin_code_editor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="6"
                    android:inputType="numberPassword"
                    style="@style/TextAppearance.AppCompat.Body1"/>
            </android.support.design.textfield.TextInputLayout>
            <ProgressBar
                android:id="@+id/member_sv_exit_unlock_progress_bar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:indeterminate="true"
                app:layout_constraintBottom_toBottomOf="@+id/member_sv_exit_unlock_editor_layout"
                app:layout_constraintEnd_toEndOf="@+id/member_sv_exit_unlock_editor_layout"
                app:layout_constraintTop_toTopOf="@+id/member_sv_exit_unlock_editor_layout"/>
        </android.support.constraint.ConstraintLayout>
        <Button
            android:id="@+id/member_sv_exit_unlock_need_help_button"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/need_help_button_label"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
            android:id="@+id/password_confirmation_avatar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/password_confirmation_email_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_regular"/>
    </LinearLayout>
    <TextView
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/password_confirmation_subheading"
        style="@style/KidSetup.Subheading"/>
    <TextView
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/password_confirmation_next_step"
        style="@style/TextAppearance.AppCompat.Body1"/>
    <TextView
        android:textSize="14sp"
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enter_password_heading"
        style="@style/TextAppearance.AppCompat.Body1"/>
    <android.support.design.textfield.TextInputLayout
        android:id="@+id/kidsetup_password_confirmation_input_layout"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:errorEnabled="true"
        app:errorTextAppearance="@style/kidsetup_edit_text_error_style"
        app:passwordToggleEnabled="true">
        <android.support.design.textfield.TextInputEditText
            android:id="@+id/kidsetup_password_confirmation_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/confirm_password_hint"
            android:maxLines="1"
            android:inputType="textPassword"
            android:imeOptions="flagNoFullscreen|actionDone"
            android:labelFor="@+id/kidsetup_password_confirmation_input_layout"
            style="@style/TextAppearance.AppCompat.Body1"/>
    </android.support.design.textfield.TextInputLayout>
</LinearLayout>

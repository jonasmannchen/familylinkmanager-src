<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/collapsible_info_section"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/collapsible_info_section_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        android:layout_marginEnd="24dp"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/collapsible_info_section_icon">
        <TextView
            android:textSize="16sp"
            android:gravity="start"
            android:id="@+id/collapsible_info_section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/quantum_ic_keyboard_arrow_down_grey600_24"
            android:paddingStart="0dp"
            android:paddingEnd="24dp"
            style="@style/TextAppearance.AppCompat.Body1"/>
        <FrameLayout
            android:id="@+id/collapsible_info_section_container"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="0dp"
            android:paddingEnd="24dp">
            <TextView
                android:textSize="14sp"
                android:gravity="start"
                android:id="@+id/collapsible_info_section_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:paddingStart="16dp"
                android:paddingEnd="0dp"
                style="@style/TextAppearance.AppCompat.Body1"/>
        </FrameLayout>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</RelativeLayout>

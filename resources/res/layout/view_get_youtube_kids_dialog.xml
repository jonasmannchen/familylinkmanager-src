<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/kidsetup_get_youtube_kids_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/kidsetup_icon_youtube_kids"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:layout_marginEnd="16dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:id="@+id/kidsetup_get_youtube_kids_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/kidsetup_get_youtube_kids_dialog_title"
        android:maxLines="1"
        android:layout_toEndOf="@+id/kidsetup_get_youtube_kids_icon"
        style="@style/quantum_text_title_black"/>
    <TextView
        android:textColor="@color/quantum_black_secondary_text"
        android:gravity="start|center_vertical"
        android:id="@+id/kidsetup_get_youtube_kids_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_below="@+id/kidsetup_get_youtube_kids_icon"
        android:layout_centerVertical="true"
        style="@style/quantum_text_subhead_black"/>
</RelativeLayout>

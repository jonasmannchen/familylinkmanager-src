<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">
        <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
            android:id="@+id/supervisee_avatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/supervisee_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_regular"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary"
        android:id="@+id/about_supervision_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/what_parents_can_supervise_description"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/about_supervision_account_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionIcon="@drawable/quantum_ic_settings_grey600_24"
        app:sectionHeader="@string/account_settings_section_heading"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/about_supervision_apps_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionIcon="@drawable/quantum_ic_shop_grey600_24"
        app:sectionHeader="@string/apps_section_heading"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/about_supervision_location_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionIcon="@drawable/quantum_ic_place_grey600_24"
        app:sectionHeader="@string/location_section_heading"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/about_supervision_screen_time_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionIcon="@drawable/quantum_ic_timer_grey600_24"
        app:sectionHeader="@string/screen_time_section_heading"/>
    <com.google.android.gms.kids.widget.CollapsibleInfoSectionView
        android:id="@+id/about_supervision_google_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionIcon="@drawable/quantum_ic_search_grey600_24"
        app:sectionHeader="@string/google_section_heading"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:paddingTop="32dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/what_parents_cant_supervise_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/what_parents_cant_supervise_description"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary"
        android:id="@+id/what_parents_cant_do_bullets"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="sans-serif"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stop_supervision_disclaimer_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stop_supervision_disclaimer_text"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="sans-serif"/>
</LinearLayout>

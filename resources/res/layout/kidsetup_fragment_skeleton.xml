<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:background="@android:color/background_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/kidsetup_header_container"
            android:background="?attr/colorPrimaryDark"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">
            <ImageView
                android:id="@+id/kidsetup_header_icon"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_marginEnd="16dp"/>
            <com.google.android.gms.kids.setup.widget.EnhancedNetworkImageView
                android:id="@+id/kidsetup_network_header_icon"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_marginEnd="16dp"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/kidsetup_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/quantum_text_title_white"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/kid_setup_main_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/kidsetup_illustration"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:layout_marginBottom="24dp"
                    android:scaleType="center"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:id="@+id/kidsetup_subheading"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:lineSpacingMultiplier="1.2"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    style="@style/TextAppearance.AppCompat.Subhead"/>
                <TextView
                    android:id="@+id/kidsetup_description"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:lineSpacingMultiplier="1.2"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    style="@style/TextAppearance.AppCompat.Subhead"/>
                <FrameLayout
                    android:id="@+id/kidsetup_content_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <com.google.android.gms.kids.setup.widget.InterstitialView
        android:id="@+id/kidsetup_interstitial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:useGlifLayout="false"/>
</merge>

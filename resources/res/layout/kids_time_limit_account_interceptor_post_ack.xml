<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/quantum_ic_warning_amber_48"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"/>
    <TextView
        android:gravity="center_horizontal"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/kids_time_limit_account_interceptor_post_ack_header"
        style="?attr/kidsTimeLimitHeadlineStyle"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/kids_time_limit_account_removed_ack_desc_txt"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/kids_time_limit_account_interceptor_post_ack_desc"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        style="?attr/kidsTimeLimitSubheadStyle"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:layout_gravity="start"
            android:id="@+id/kids_time_limit_account_removed_ack_close_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/close_button_label"
            style="?attr/borderlessButtonStyle"/>
        <Button
            android:layout_gravity="end"
            android:id="@+id/kids_time_limit_account_removed_ack_add_account_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kids_time_limit_add_account_btn"/>
    </FrameLayout>
</LinearLayout>

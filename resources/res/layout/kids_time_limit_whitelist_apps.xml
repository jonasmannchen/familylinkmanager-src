<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.v7.widget.Toolbar
        android:gravity="center_vertical"
        android:id="@+id/kids_time_limit_whitelist_apps_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/kids_time_limit_whitelist_apps_toolbar_title"
        app:navigationIcon="@drawable/quantum_ic_arrow_back_white_24"
        app:navigationContentDescription="@string/common_back"/>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/kids_time_limit_whitelist_apps_list"
        android:background="@color/quantum_white_100"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</LinearLayout>

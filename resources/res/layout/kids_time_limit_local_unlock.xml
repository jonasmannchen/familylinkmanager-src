<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.25"/>
    <TextView
        android:gravity="center"
        android:id="@+id/kids_time_limit_unlock_header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/kids_time_limit_unlock_title"
        style="?attr/kidsTimeLimitHeadlineStyle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/kids_time_limit_unlock_header_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/kids_time_limit_unlock_description"
        style="?attr/kidsTimeLimitSubheadStyle"/>
    <android.support.design.widget.TextInputLayout
        android:id="@+id/kids_time_limit_local_unlock_editor_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:errorEnabled="true"
        app:errorTextAppearance="@style/Kids.LockScreenCodeEditorErrorStyle">
        <com.google.android.gms.kids.widget.PinCodeEditor
            android:id="@+id/kids_time_limit_local_unlock_pin_code_editor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLength="6"
            android:inputType="number"
            style="@style/Kids.LockScreenCodeEditorStyle"/>
    </android.support.design.widget.TextInputLayout>
    <Button
        android:id="@+id/kids_time_limit_local_unlock_need_help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/local_unlock_need_help_button"
        style="?attr/borderlessButtonStyle"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.75"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.gms.kids.setup.widget.AppDetailHeaderView
        android:id="@+id/kidsetup_app_detail_header_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <View
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        style="@style/kidsetup_horizontal_divider"/>
    <FrameLayout
        android:id="@+id/kidsetup_app_detail_google_search_switch_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/kidsetup_app_detail_google_search_switch_divider"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        style="@style/kidsetup_horizontal_divider"/>
    <com.google.android.gms.kids.setup.widget.AppDetailDescriptionView
        android:id="@+id/kidsetup_app_detail_description_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <TextView
        android:id="@+id/kidsetup_app_detail_non_play_app_text_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/kidsetup_app_detail_non_play_app_description"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        style="@style/quantum_text_subhead_black"/>
    <View
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        style="@style/kidsetup_horizontal_divider"/>
    <com.google.android.gms.kids.setup.widget.AppDetailRatingView
        android:id="@+id/kidsetup_app_detail_rating_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <View
        android:id="@+id/kidsetup_app_detail_info_divider"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        style="@style/kidsetup_horizontal_divider"/>
    <com.google.android.gms.kids.setup.widget.AppDetailInfoView
        android:id="@+id/kidsetup_app_detail_info_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <View
        android:id="@+id/kidsetup_app_detail_review_permissions_divider"
        android:layout_marginTop="24dp"
        style="@style/kidsetup_horizontal_divider"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/kidsetup_app_detail_review_permissions"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/kidsetup_app_detail_permissions_content_description"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/kidsetup_ic_shield"
            android:alpha="0.54"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kidsetup_app_detail_permission_details"
            android:layout_marginStart="16dp"
            style="@style/quantum_text_black_dark"/>
    </LinearLayout>
</LinearLayout>

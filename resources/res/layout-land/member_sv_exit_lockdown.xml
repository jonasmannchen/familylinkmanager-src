<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <android.support.constraint.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5">
        <ProgressBar
            android:id="@+id/member_sv_exit_lockdown_progress_bar"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:max="100"
            android:progressDrawable="@drawable/member_sv_exit_lockdown_progress_bar"
            android:rotation="-90"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <ImageView
            android:id="@+id/member_sv_exit_lockdown_lock_image"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/quantum_ic_lock_black_36"
            android:tint="@color/quantum_googred"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/member_sv_exit_lockdown_time_remaining"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="36sp"
            android:textColor="@color/quantum_black_text"
            android:id="@+id/member_sv_exit_lockdown_time_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_regular"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/quantum_black_secondary_text"
            android:gravity="center"
            android:id="@+id/member_sv_exit_lockdown_time_remaining_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/member_sv_exit_lockdown_device_will_unlock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/member_sv_exit_lockdown_time_remaining"/>
    </android.support.constraint.ConstraintLayout>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_weight="0.5"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:text="@string/device_locked"
                style="@style/KidSetup.Headline"/>
            <TextView
                android:id="@+id/member_sv_exit_lockdown_subheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/member_sv_exit_lockdown_subheading_no_account"
                style="@style/KidSetup.Subheading"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/quantum_black_text"
                android:gravity="center"
                android:id="@+id/member_sv_exit_lockdown_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/member_sv_exit_lockdown_description_no_account"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">
                <Button
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"
                    android:id="@+id/member_sv_exit_lockdown_parent_access_button"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/kids_time_limit_unlock_btn"
                    android:fontFamily="sans-serif-medium"
                    style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"
                    android:id="@+id/member_sv_exit_lockdown_emergency_button"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/kids_time_limit_emergency_btn"
                    android:fontFamily="sans-serif-medium"
                    style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
